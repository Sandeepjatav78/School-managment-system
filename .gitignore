# Dependencies
node_modules/

# Build output (client builds into server/public for single-process deploy)
dist/
# server/public is intentionally committed so the client ships to Vercel

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Coverage / test output
coverage/

# Keys & credentials — NEVER commit these
*.pem
*.key
*.p12
*.cer
deploy/ssl/

# Deploy artifacts
.deploy/
deploy/*.tar.gz