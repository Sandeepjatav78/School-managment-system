# Copy to .env and fill in. NEVER commit the real .env file.

NODE_ENV=production
PORT=5050

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d

# Required in production. Use MongoDB Atlas (mongodb+srv://...) or your own instance.
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/athena

# Comma-separated list of allowed browser origins (CORS).
# Leave empty when the app is served by this server itself (single-process deploy).
CORS_ORIGIN=https://school.example.com

# Only seed demo data on an empty database when this is explicitly "true".
# Keep it false in production.
ALLOW_SEEDING=false